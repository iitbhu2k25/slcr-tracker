# Copy to .env.local for local development.

# Random secret used to sign login cookies: at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=902a81d329e3cce937f736c7f89ea0615bda31b1418f24872461818b4f3ecb16

# One-time key you type on the /setup page to create the administrator account.
SETUP_KEY=slcr2026

# Set to "1" in Vercel AFTER completing /setup. Prevents redirect back to /setup on cold starts.
# SETUP_DONE=1

# Supabase project (Dashboard → Project Settings → API).
# The service-role key is used ONLY on the server. Never expose it to the browser
# or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
